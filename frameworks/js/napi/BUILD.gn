import("//base/notification/distributed_notification_service/notification.gni")
import("//build/ohos.gni")

group("napi_reminder") {
  deps = [
    "src/reminder:reminderagent",
    "src/reminder:reminderagentmanager",
  ]
}

group("napi_notification") {
  deps = [
    ":notification",
    "src/manager:notificationmanager",
    "src/subscribe:notificationsubscribe",
  ]
}

group("napi_extension_subscription") {
  deps = [
    "src/extension:notification_subscriber_extension",
    "src/extension:notification_subscriber_extension_module",
    "src/extension_subscription:notificationextensionsubscription",
  ]
}

config("native_module_config") {
  visibility = [ ":*" ]

  include_dirs = []

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
}

# ROM size optimization: shared common library for NAPI modules [PR#4766 借鉴].
# All common*.cpp / constant.cpp / slot.cpp / subscribe.cpp files are compiled
# once here and linked by individual NAPI targets to eliminate redundant code.
ohos_shared_library("notification_napi_common") {
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  include_dirs = [
    "include",
    "include/manager",
    "include/subscribe",
    "${inner_api_path}",
    "${core_path}/common/include",
  ]

  configs = [ ":native_module_config" ]

  cflags = notification_size_opt_cflags
  ldflags = notification_size_opt_ldflags
  cflags_cc = notification_size_opt_cflags_cc
  # 公共库不加 -fvisibility=hidden [PR#4766 借鉴]

  sources = [
    "src/ans_template.cpp",
    "src/cancel.cpp",
    "src/common.cpp",
    "src/common2.cpp",
    "src/common_convert_content.cpp",
    "src/common_convert_liveview.cpp",
    "src/common_convert_notification.cpp",
    "src/common_convert_notification_parameters.cpp",
    "src/common_convert_request.cpp",
    "src/common_convert_trigger.cpp",
    "src/common_utils.cpp",
    "src/constant.cpp",
    "src/disable_notification.cpp",
    "src/display_badge.cpp",
    "src/distributed.cpp",
    "src/disturb_mode.cpp",
    "src/enable_notification.cpp",
    "src/get_active.cpp",
    "src/js_ans_dialog_callback.cpp",
    "src/manager/napi_slot.cpp",
    "src/priority.cpp",
    "src/publish.cpp",
    "src/remove.cpp",
    "src/slot.cpp",
    "src/subscribe.cpp",
    "src/unsubscribe.cpp",
    "${core_path}/src/image_pixelmap_helper.cpp",
    "${core_path}/src/pixelmap_cache_manager.cpp",
    "${core_path}/src/subscriber_image_util.cpp",
  ]

  version_script = "libnotification_napi_common.map"

  deps = [ "${frameworks_module_ans_path}:ans_innerkits" ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:ability_manager",
    "ability_runtime:abilitykit_native",
    "ability_runtime:app_context",
    "ability_runtime:napi_common",
    "ability_runtime:napi_wantagent_common",
    "ability_runtime:wantagent_innerkits",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hitrace:libhitracechain",
    "image_framework:image",
    "image_framework:image_source",
    "image_framework:pixelmap",
    "resource_management:librawfile",
    "resource_management:global_resmgr",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "libuv:uv",
    "napi:ace_napi",
    "node:node_header_notice",
    "os_account:os_account_innerkits",
    "relational_store:native_rdb",
  ]

  subsystem_name = "${subsystem_name}"
  part_name = "${component_name}"
}

ohos_shared_library("notification") {
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  include_dirs = [ "include" ]

  configs = [ ":native_module_config" ]

  cflags = notification_size_opt_cflags
  ldflags = notification_size_opt_ldflags
  cflags_cc = notification_size_opt_cflags_cc

  sources = [
    "src/init.cpp",
  ]

  version_script = "libnotification.map"

  deps = [
    ":notification_napi_common",
    "${frameworks_module_ans_path}:ans_innerkits",
    "${frameworks_module_reminder_path}:reminder_innerkits",
  ]

  defines = []

  if (distributed_notification_service_feature_badge_manager) {
    defines += [ "ANS_FEATURE_BADGE_MANAGER" ]
  }

  if (distributed_notification_service_feature_local_liveview) {
    defines += [ "ANS_FEATURE_LIVEVIEW_LOCAL_LIVEVIEW" ]
  }

  if (distributed_notification_service_feature_distributed_supported) {
    defines += [ "ANS_FEATURE_DISTRIBUTED_SUPPORTED" ]
  }

  if (distributed_notification_service_feature_original_distributed) {
    defines += [ "ANS_FEATURE_ORIGINAL_DISTRIBUTED" ]
  }

  if (distributed_notification_service_feature_disturb_manager) {
    defines += [ "ANS_FEATURE_DISTURB_MANAGER" ]
  }

  if (distributed_notification_service_feature_slot_manager) {
    defines += [ "ANS_FEATURE_SLOT_MANAGER" ]
  }

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:ability_manager",
    "ability_runtime:abilitykit_native",
    "ability_runtime:app_context",
    "ability_runtime:napi_common",
    "ability_runtime:napi_wantagent_common",
    "ability_runtime:wantagent_innerkits",
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hitrace:libhitracechain",
    "image_framework:image",
    "image_framework:image_source",
    "image_framework:pixelmap",
    "resource_management:librawfile",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "libuv:uv",
    "napi:ace_napi",
    "node:node_header_notice",
    "os_account:os_account_innerkits",
    "relational_store:native_rdb",
    "resource_management:global_resmgr",
  ]

  relative_install_dir = "module"
  subsystem_name = "${subsystem_name}"
  part_name = "${component_name}"
}
